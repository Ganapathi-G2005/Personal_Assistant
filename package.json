{
  "name": "sidekick-formatting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Formatting and lint workflow for Sidekick frontend/docs",
  "scripts": {
    "format": "prettier --write \"public/**/*.{js,css,html}\" \"README.md\" \"FORMATTING.md\"",
    "format:check": "prettier --check \"public/**/*.{js,css,html}\" \"README.md\" \"FORMATTING.md\"",
    "lint:js": "eslint public/app.js --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
